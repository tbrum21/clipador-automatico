# ===== Live monitorada =====
TWITCH_CHANNEL=nome_do_canal
STREAM_QUALITY=720p60,720p,best
# Gravacoes de uma hora: melhor qualidade disponivel na live (normalmente 1080p).
HOURLY_STREAM_QUALITY=best

# ===== Docker: modelo multilíngue tiny, base ou small =====
WHISPER_MODEL_NAME=base

# ===== Ferramentas (no Docker, os caminhos sao definidos pelo Compose) =====
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
STREAMLINK_PATH=streamlink
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/models/ggml-base.bin
WHISPER_LANG=pt
WHISPER_THREADS=6

# ===== Docker usa libx264 (CPU); h264_amf apenas na execucao nativa Windows =====
ENCODER=libx264

# ===== Telegram =====
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== IA para ajustar inicio/fim e sugerir titulo (opcional) =====
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ===== Deteccao de pico no chat =====
PEAK_Z=3.0
PEAK_MIN_MSGS=12
COOLDOWN_SECONDS=90

# ===== Recorte =====
PRE_SECONDS=25
POST_SECONDS=10
ZOOM=1
